[Unit]
Description=Dental clinic website (gunicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=dental
Group=dental
WorkingDirectory=/srv/dental-clinic/app/backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/dental-clinic/app/backend/venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8001 --workers 3 --timeout 30 --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
